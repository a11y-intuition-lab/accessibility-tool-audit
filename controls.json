{
  "about": "Control pages for the AI check. Each page is meant to pass the checks in ai-checks.json, so any failure the AI reports on them is a false positive. They use the same template as the test pages and are generated into controls/.",
  "controls": {
    "Dialog that manages focus": "<p><button type=\"button\" id=\"open-dialog\">Show opening times</button></p>\n<div role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"dialog-title\" id=\"dialog\" hidden style=\"border: 2px solid #0b0c0c; padding: 1em; max-width: 30em; background: #fff;\">\n<h2 id=\"dialog-title\">Opening times</h2>\n<p>The office is open Monday to Friday, 9am to 5pm.</p>\n<p><a href=\"https://www.gov.uk/contact\">Contact the office</a></p>\n<button type=\"button\" id=\"close-dialog\">Close</button>\n</div>\n<script>\n(function () {\n  var opener = document.getElementById('open-dialog');\n  var dialog = document.getElementById('dialog');\n  var close = document.getElementById('close-dialog');\n  function hide() { dialog.hidden = true; opener.focus(); }\n  opener.addEventListener('click', function () { dialog.hidden = false; close.focus(); });\n  close.addEventListener('click', hide);\n  dialog.addEventListener('keydown', function (e) {\n    if (e.key === 'Escape') { hide(); return; }\n    if (e.key !== 'Tab') return;\n    var items = dialog.querySelectorAll('a, button');\n    var first = items[0], last = items[items.length - 1];\n    if (e.shiftKey && document.activeElement === first) { last.focus(); e.preventDefault(); }\n    else if (!e.shiftKey && document.activeElement === last) { first.focus(); e.preventDefault(); }\n  });\n})();\n</script>",
    "Tooltip that can be dismissed and hovered": "<p>\n<button type=\"button\" id=\"tip-button\" aria-describedby=\"tip\">Delivery options</button>\n<span role=\"tooltip\" id=\"tip\" hidden style=\"margin-left: 0; padding: 0.5em; border: 1px solid #0b0c0c; background: #fff;\">Standard delivery takes 3 to 5 working days.</span>\n</p>\n<script>\n(function () {\n  var b = document.getElementById('tip-button');\n  var t = document.getElementById('tip');\n  var wrap = b.parentNode;\n  function show() { t.hidden = false; }\n  function hide() { t.hidden = true; }\n  wrap.addEventListener('mouseenter', show);\n  wrap.addEventListener('mouseleave', hide);\n  b.addEventListener('focus', show);\n  b.addEventListener('blur', hide);\n  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') hide(); });\n})();\n</script>",
    "Form with labels, hints and autocomplete": "<form action=\"#\" novalidate>\n<div><label for=\"full-name\">Full name</label><br><input type=\"text\" id=\"full-name\" name=\"full-name\" autocomplete=\"name\" style=\"border: 2px solid #0b0c0c;\"></div>\n<div><label for=\"email\">Email address</label><br><span id=\"email-hint\">We will only use this to send you a receipt.</span><br><input type=\"email\" id=\"email\" name=\"email\" autocomplete=\"email\" aria-describedby=\"email-hint\" style=\"border: 2px solid #0b0c0c;\"></div>\n<div><label for=\"password\">Password</label><br><input type=\"password\" id=\"password\" name=\"password\" autocomplete=\"current-password\" style=\"border: 2px solid #0b0c0c;\"></div>\n<div id=\"errors\" role=\"alert\"></div>\n<button type=\"submit\">Continue</button>\n</form>\n<script>\n(function () {\n  var form = document.querySelector('form');\n  form.addEventListener('submit', function (e) {\n    e.preventDefault();\n    var missing = [];\n    if (!form['full-name'].value) missing.push('Enter your full name');\n    if (!form.email.value) missing.push('Enter your email address, like name@example.com');\n    if (!form.password.value) missing.push('Enter your password');\n    document.getElementById('errors').textContent = missing.length ? 'There is a problem: ' + missing.join('. ') + '.' : '';\n  });\n})();\n</script>",
    "Descriptive links": "<p>The polar bear lives mainly inside the Arctic Circle. <a href=\"https://en.wikipedia.org/wiki/Polar_bear\">Read more about polar bears on Wikipedia</a>.</p>\n<p><a href=\"https://www.gov.uk/government/publications/dyslexia-style-guide.pdf\">Dyslexia style guide (PDF, 250 KB)</a></p>\n<p><a href=\"https://www.gov.uk/\" target=\"_blank\">GOV.UK (opens in a new window)</a></p>\n<ul>\n<li><a href=\"https://www.gov.uk/browse/benefits\">Benefits</a></li>\n<li><a href=\"https://www.gov.uk/browse/housing-local-services\">Housing and local services</a></li>\n</ul>",
    "Images with text alternatives": "<p><img src=\"images/red_panda.jpg\" alt=\"A red panda walking on the ground beside a tree trunk\" width=\"300\"></p>\n<p><img src=\"images/decoration.png\" alt=\"\" width=\"100\"> The red panda is a small mammal native to the eastern Himalayas.</p>\n<p><a href=\"https://en.wikipedia.org/wiki/Red_panda\">Red panda on Wikipedia</a></p>",
    "Data table with caption and headers": "<table>\n<caption>Opening times</caption>\n<thead><tr><th scope=\"col\">Time</th><th scope=\"col\">Monday to Friday</th><th scope=\"col\">Saturday</th><th scope=\"col\">Sunday</th></tr></thead>\n<tbody>\n<tr><th scope=\"row\">08:00 to 12:00</th><td>Open</td><td>Open</td><td>Closed</td></tr>\n<tr><th scope=\"row\">12:00 to 16:00</th><td>Open</td><td>Closed</td><td>Closed</td></tr>\n</tbody>\n</table>",
    "Headings and lists": "<h2>What you need</h2>\n<p>You need these documents to apply:</p>\n<ul>\n<li>your passport</li>\n<li>a recent utility bill</li>\n<li>your National Insurance number</li>\n</ul>\n<h2>How to apply</h2>\n<ol>\n<li>Fill in the form.</li>\n<li>Upload your documents.</li>\n<li>Pay the fee.</li>\n</ol>",
    "Text in other languages": "<p>Mother, he is asking you to go. He is saying, &ldquo;<span lang=\"fr\">Allons, Madame plaisante!</span>&rdquo;</p>\n<p>The Arabic name of the service is <span lang=\"ar\" dir=\"rtl\">الإعفاء الإلكتروني من التأشيرة</span>.</p>",
    "Plain language": "<p>The Government Digital Service (GDS) is part of the Cabinet Office. GDS helps government teams build online services that are simple to use.</p>\n<p>If you are not happy with a decision, you can ask us to look at it again. Write to us within one month of the decision.</p>",
    "Readable text block": "<p style=\"max-width: 34em; line-height: 1.6; font-size: 19px;\">Many people find it easier to read text when lines are short and well spaced. This paragraph is left aligned, uses regular letters and has space between the lines, so it is easy to follow from one line to the next.</p>",
    "Clear focus indicator": "<style>.control-focus a:focus, .control-focus button:focus { outline: 3px solid #0b0c0c; outline-offset: 2px; background: #ffdd00; }</style>\n<div class=\"control-focus\">\n<p><a href=\"https://www.gov.uk/council-tax\">Find out about council tax</a></p>\n<p><button type=\"button\">Search</button></p>\n</div>",
    "Navigation with skip link, search and breadcrumbs": "<a href=\"#content\" class=\"skip\">Skip to main content</a>\n<header>\n<nav aria-label=\"Main\">\n<ul class=\"spaced-links\">\n<li><a href=\"https://www.gov.uk/browse/benefits\">Benefits</a></li>\n<li><a href=\"https://www.gov.uk/browse/housing-local-services\" aria-current=\"page\">Housing</a></li>\n<li><a href=\"https://www.gov.uk/browse/tax\">Money and tax</a></li>\n</ul>\n</nav>\n<form role=\"search\" action=\"https://www.gov.uk/search\"><label for=\"q\">Search this site</label> <input type=\"search\" id=\"q\" name=\"q\" style=\"border: 2px solid #0b0c0c;\"> <button type=\"submit\">Search</button></form>\n</header>\n<nav aria-label=\"Breadcrumb\"><ol class=\"spaced-links\"><li><a href=\"https://www.gov.uk/\">Home</a></li><li><a href=\"https://www.gov.uk/browse/housing-local-services\">Housing</a></li><li aria-current=\"page\">Housing Benefit</li></ol></nav>\n<div id=\"content\" tabindex=\"-1\"><h2>Housing Benefit</h2><p>Housing Benefit can help you pay your rent if you are unemployed or on a low income.</p></div>\n<p><a href=\"https://www.gov.uk/sitemap\">Site map</a></p>",
    "Video with captions and transcript": "<video controls width=\"320\" src=\"media/speech-video.mp4\"><track kind=\"captions\" srclang=\"en\" label=\"English\" src=\"media/speech-video.vtt\" default></video>\n<h2>Transcript</h2>\n<p style=\"max-width: 34em; line-height: 1.6;\">Welcome to the recycling service. Your bin collection day has changed from Monday to Thursday. Please put your bin out by seven in the morning. Thank you for recycling.</p>",
    "Status message in a live region": "<p><button type=\"button\" id=\"add\">Add to basket</button></p>\n<p role=\"status\" id=\"basket-status\"></p>\n<script>\ndocument.getElementById('add').addEventListener('click', function () {\n  document.getElementById('basket-status').textContent = '1 item added to your basket.';\n});\n</script>",
    "Carousel with buttons": "<div role=\"group\" aria-roledescription=\"carousel\" aria-label=\"Services\">\n<p id=\"slide\" aria-live=\"polite\">Slide 1 of 3: Apply for a passport online</p>\n<button type=\"button\" id=\"prev\">Previous slide</button> <button type=\"button\" id=\"next\">Next slide</button>\n</div>\n<script>\n(function () {\n  var slides = ['Slide 1 of 3: Apply for a passport online', 'Slide 2 of 3: Renew your driving licence', 'Slide 3 of 3: Check your State Pension age'];\n  var i = 0;\n  function show() { document.getElementById('slide').textContent = slides[i]; }\n  document.getElementById('prev').addEventListener('click', function () { i = (i + slides.length - 1) % slides.length; show(); });\n  document.getElementById('next').addEventListener('click', function () { i = (i + 1) % slides.length; show(); });\n})();\n</script>",
    "Reorder with buttons": "<p>Put the contact methods in order of preference.</p>\n<ol id=\"order\">\n<li><span>Email</span> <button type=\"button\" class=\"up\">Move Email up</button> <button type=\"button\" class=\"down\">Move Email down</button></li>\n<li><span>Text message</span> <button type=\"button\" class=\"up\">Move Text message up</button> <button type=\"button\" class=\"down\">Move Text message down</button></li>\n<li><span>Letter</span> <button type=\"button\" class=\"up\">Move Letter up</button> <button type=\"button\" class=\"down\">Move Letter down</button></li>\n</ol>\n<script>\ndocument.getElementById('order').addEventListener('click', function (e) {\n  var li = e.target.closest('li');\n  if (e.target.classList.contains('up') && li.previousElementSibling) li.parentNode.insertBefore(li, li.previousElementSibling);\n  if (e.target.classList.contains('down') && li.nextElementSibling) li.parentNode.insertBefore(li.nextElementSibling, li);\n  e.target.focus();\n});\n</script>",
    "Delete with confirmation": "<p>You have 12 saved messages.</p>\n<p><button type=\"button\" id=\"delete\">Delete all messages</button></p>\n<div id=\"confirm\" hidden>\n<p id=\"confirm-text\">Are you sure you want to delete all 12 messages? You cannot undo this.</p>\n<button type=\"button\" id=\"yes\">Yes, delete all messages</button> <button type=\"button\" id=\"no\">No, keep my messages</button>\n</div>\n<p role=\"status\" id=\"result\"></p>\n<script>\n(function () {\n  var c = document.getElementById('confirm');\n  document.getElementById('delete').addEventListener('click', function () { c.hidden = false; document.getElementById('no').focus(); });\n  document.getElementById('no').addEventListener('click', function () { c.hidden = true; document.getElementById('delete').focus(); });\n  document.getElementById('yes').addEventListener('click', function () { c.hidden = true; document.getElementById('result').textContent = 'All messages deleted.'; });\n})();\n</script>",
    "Box that grows with its text": "<div style=\"border: 2px solid #0b0c0c; padding: 1em; max-width: 30em; min-height: 3em;\">This service is for England and Wales only. You must contact individual prisons in Northern Ireland or Scotland to book a visit.</div>",
    "Colour with text": "<p>Mushrooms marked &ldquo;Safe&rdquo; are OK to eat. Mushrooms marked &ldquo;Poisonous&rdquo; will make you ill.</p>\n<ul>\n<li><span style=\"color: #00703c;\">Chanterelle: Safe</span></li>\n<li><span style=\"color: #d4351c;\">Amanita: Poisonous</span></li>\n<li><span style=\"color: #00703c;\">Porcini: Safe</span></li>\n</ul>",
    "Contrasting field and icon button": "<p><label for=\"search-box\">Search</label><br><input type=\"search\" id=\"search-box\" style=\"border: 2px solid #505a5f;\"> <button type=\"button\" aria-label=\"Search\" style=\"background: #fff; border: 2px solid #0b0c0c; color: #0b0c0c; font-size: 1.2em;\">&#x1F50D;&#xFE0E;</button></p>",
    "Expandable sections with buttons": "<h2><button type=\"button\" aria-expanded=\"false\" aria-controls=\"sec-1\">Understanding user research</button></h2>\n<div id=\"sec-1\" hidden><p>User research helps you understand the people who use your service.</p></div>\n<h2><button type=\"button\" aria-expanded=\"false\" aria-controls=\"sec-2\">Plan user research</button></h2>\n<div id=\"sec-2\" hidden><p>Plan research for each phase of your service.</p></div>\n<script>\ndocument.querySelectorAll('[aria-controls]').forEach(function (b) {\n  b.addEventListener('click', function () {\n    var open = b.getAttribute('aria-expanded') === 'true';\n    b.setAttribute('aria-expanded', String(!open));\n    document.getElementById(b.getAttribute('aria-controls')).hidden = open;\n  });\n});\n</script>"
  }
}
