<body{% if fixtures %} class="tests site-fixtures-page"{% endif %}>
  <a class="site-skip" href="#main">Skip to main content</a>
  <header class="site-header">
    <div class="site-header-inner">
      <p class="site-brand-block">
        <a class="site-brand" href="https://a11yintuition.org/">A11y Intuition Lab</a>
        <span class="site-name"><a href="{{ '/' | url }}">{{ site.name }}</a></span>
      </p>
      <nav aria-label="Main">
        <ul class="site-nav">
          {%- set items = [
            { href: '/', label: 'Overview' },
            { href: '/test-cases.html', label: 'Test cases' },
            { href: '/results.html', label: 'Results' },
            { href: '/methodology.html', label: 'Methodology' },
            { href: '/about.html', label: 'About' }
          ] %}
          {%- for item in items %}
          <li><a href="{{ item.href | url }}"{% if item.href == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
    </div>
  </header>
  <main id="main" tabindex="-1">
{{ content | safe }}
  </main>
  <footer class="site-footer">
    <div class="site-footer-inner">
      <p>Released under the <a href="{{ site.repo }}/blob/gh-pages/LICENSE" rel="license">MIT licence</a>.</p>
