# Supply-chain hardening. See wiki/method/supply-chain-security.md
registry=https://registry.npmjs.org/
strict-ssl=true
min-release-age=7
ignore-scripts=true
save-exact=true
package-lock=true
engine-strict=true
audit=true
audit-level=high
allow-git=none
allow-remote=none
allow-file=none
allow-directory=root
fund=false
update-notifier=false
